# roku-monitor configuration.
# Linux:   ~/.config/roku-monitor/env  (install.sh puts it there, mode 0600)
# Windows: %APPDATA%\roku-monitor\env  (install.ps1 puts it there)
# Values starting with '<' are placeholders and count as unset. Never commit real
# IPs/serials/MACs — this file is the committed template, the real one is private.

# --- which TV -----------------------------------------------------------------
# Required. `roku-monitor discover` lists Rokus with IP/serial/MAC.
# Give the TV a DHCP reservation on your router so this does not drift.
ROKU_TV_IP=<tv-ip>
# Recommended. If set, the daemon refuses to command a device at ROKU_TV_IP whose
# serial differs (protects you when DHCP hands the TV's old address to another Roku).
ROKU_TV_SERIAL=<serial>
# Optional. Used for a best-effort Wake-on-LAN when the TV has gone to deep sleep.
# Roku TVs on Wi-Fi are reported to ignore it; the reliable path is 'Fast TV start'.
ROKU_TV_MAC=<tv-mac>
# Which TV input the PC is plugged into: hdmi1 hdmi2 hdmi3 hdmi4 av1 tuner
ROKU_INPUT=hdmi3

# --- which PC output ----------------------------------------------------------
# Linux only. Auto-detected from the EDID (vendor RKU). Override only if
# detection fails, e.g. HDMI-A-1 (see: ls /sys/class/drm). Ignored on Windows,
# which reports one display-power state for the whole console.
ROKU_CONNECTOR=

# --- behaviour ----------------------------------------------------------------
# The rule is: displays on -> TV on + ROKU_INPUT; displays off -> TV off. No exceptions.
# One courtesy for a *shared* TV, both directions: while someone else is watching
# it, the daemon will neither turn it off when the PC blanks nor switch its input
# away when the PC wakes. Off by default - the TV is your monitor.
# Why a switch: the trade-off is that the PC does not get that screen back on its
# own. The daemon never re-asserts on a schedule, so once it has stood aside the
# display stays theirs until they stop, you lock/unlock the PC, or you run
# `roku-monitor on --force`. The volume mirror stays out of it meanwhile.
# "Someone else is watching" means a real app: a TV sitting on its Home screen or
# a screensaver belongs to nobody and is treated normally.
# (ROKU_ONLY_OFF_WHEN_ON_INPUT is the old name for this and is still read.)
ROKU_SHARED_TV=false
# Go one step further: while someone else is using the TV, stop *driving* its
# output too, so the desktop does not extend onto a screen showing their show and
# the pointer cannot wander off into it. Linux + GNOME only (Wayland or Xorg);
# ignored on Windows. Implies ROKU_SHARED_TV.
# Why a switch: it is the one thing here that changes the PC rather than the TV.
# Releasing an output is a layout change, so GNOME will move any windows that
# were on the TV over to your other screen and will not move them back. It also
# needs python3-gi and a GNOME session bus, and it does nothing at all if the TV
# is the only screen this PC has - releasing that would leave you with none.
ROKU_RELEASE_DISPLAY=false
# How often to ask the TV what it is showing, in seconds, while the displays are
# on. Only used when ROKU_RELEASE_DISPLAY=true; 0 turns the check off. This is
# the daemon's only periodic call to the TV, which is why it is slow and opt-in:
# nothing else here polls.
ROKU_SHARE_POLL_S=20
# Turn the TV off right before suspend (Linux: needs python3-gi) and when the
# daemon stops — logout on Linux, sign-out/shutdown on Windows.
# Note: `systemctl --user restart` is a stop+start, i.e. a brief TV off/on blink.
ROKU_OFF_ON_SLEEP=true
ROKU_OFF_ON_STOP=true

# --- volume (optional) ----------------------------------------------------------
# Make the PC's volume control drive the TV's *own* volume, so the PC sends
# full-scale audio and nothing is attenuated twice, and no remote is needed.
# Why a switch: it changes how your volume control behaves.
# Linux: `install.sh --volume` adds a PipeWire "Roku TV" output (a drop-in in
# ~/.config/pipewire/pipewire.conf.d/) whose slider the daemon mirrors to the
# TV (and back at power-on). Needs pw-dump and wpctl.
# Windows: `install.ps1 -Volume`; a keyboard hook forwards the volume keys to
# the TV while the Roku TV is the default output (the TV's bar is the display).
ROKU_VOLUME=false

# --- timing ----------------------------------------------------------------------
# How often /sys/class/drm is read (seconds). 1s costs well under a millisecond.
ROKU_POLL_S=1
# Grace after the displays go dark before the TV is told to turn off; cancelled if
# they come back. Absorbs a blank->mouse-wiggle blip without power-cycling the TV.
ROKU_OFF_DELAY_S=10
# Per-request ECP timeout and how long to wait for the TV to report PowerOn
# (a cold boot with Fast TV start off takes ~30s).
ROKU_ECP_TIMEOUT_S=3
ROKU_POWERON_TIMEOUT_S=45

# --- network --------------------------------------------------------------------
# Broadcast address for Wake-on-LAN. Change on multi-homed hosts (docker, VPN) if
# 255.255.255.255 leaves on the wrong interface, e.g. 192.168.x.255 for your LAN.
ROKU_WOL_BROADCAST=255.255.255.255

# DEBUG | INFO | WARNING
ROKU_LOG_LEVEL=INFO
