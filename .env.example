# roku-monitor configuration.
# Linux:   ~/.config/roku-monitor/env  (install.sh puts it there, mode 0600)
# Windows: %APPDATA%\roku-monitor\env  (install.ps1 puts it there)
# Values starting with '<' are placeholders and count as unset. Never commit real
# IPs/serials/MACs — this file is the committed template, the real one is private.

# --- which TV -----------------------------------------------------------------
# Required. `roku-monitor discover` lists Rokus with IP/serial/MAC.
# Give the TV a DHCP reservation on your router so this does not drift.
ROKU_TV_IP=<tv-ip>
# Recommended. If set, the daemon refuses to command a device at ROKU_TV_IP whose
# serial differs (protects you when DHCP hands the TV's old address to another Roku).
ROKU_TV_SERIAL=<serial>
# Optional. Used for a best-effort Wake-on-LAN when the TV has gone to deep sleep.
# Roku TVs on Wi-Fi are reported to ignore it; the reliable path is 'Fast TV start'.
ROKU_TV_MAC=<tv-mac>
# Which TV input the PC is plugged into: hdmi1 hdmi2 hdmi3 hdmi4 av1 tuner
ROKU_INPUT=hdmi3

# --- which PC output ----------------------------------------------------------
# Linux only. Auto-detected from the EDID (vendor RKU). Override only if
# detection fails, e.g. HDMI-A-1 (see: ls /sys/class/drm). Ignored on Windows,
# which reports one display-power state for the whole console.
ROKU_CONNECTOR=

# --- behaviour ----------------------------------------------------------------
# The rule is: displays on -> TV on + ROKU_INPUT; displays off -> TV off. No exceptions.
# Set this to true only if the TV is shared and you want it left alone when it is
# showing something other than the PC's input at the moment the PC blanks.
ROKU_ONLY_OFF_WHEN_ON_INPUT=false
# Turn the TV off right before suspend (Linux: needs python3-gi) and when the
# daemon stops — logout on Linux, sign-out/shutdown on Windows.
# Note: `systemctl --user restart` is a stop+start, i.e. a brief TV off/on blink.
ROKU_OFF_ON_SLEEP=true
ROKU_OFF_ON_STOP=true

# --- timing ----------------------------------------------------------------------
# How often /sys/class/drm is read (seconds). 1s costs well under a millisecond.
ROKU_POLL_S=1
# Grace after the displays go dark before the TV is told to turn off; cancelled if
# they come back. Absorbs a blank->mouse-wiggle blip without power-cycling the TV.
ROKU_OFF_DELAY_S=10
# Per-request ECP timeout and how long to wait for the TV to report PowerOn
# (a cold boot with Fast TV start off takes ~30s).
ROKU_ECP_TIMEOUT_S=3
ROKU_POWERON_TIMEOUT_S=45

# --- network --------------------------------------------------------------------
# Broadcast address for Wake-on-LAN. Change on multi-homed hosts (docker, VPN) if
# 255.255.255.255 leaves on the wrong interface, e.g. 192.168.x.255 for your LAN.
ROKU_WOL_BROADCAST=255.255.255.255

# DEBUG | INFO | WARNING
ROKU_LOG_LEVEL=INFO
